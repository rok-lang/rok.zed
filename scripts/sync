#!/bin/sh
# Writes highlights.scm and injections.scm of languages/rok and
# languages/rokon from rok-syntax's tree-sitter queries, renaming
# captures to the names Zed themes style, and keeps the grammar revs in
# extension.toml on the commit in rok-syntax.rev.
#
#   scripts/sync                       fetch at the commit in rok-syntax.rev
#   scripts/sync --from DIR            copy from a rok-syntax checkout, pin its HEAD
#   scripts/sync --check [--from DIR]  fail if the queries or revs differ
#
# The generated files are never edited by hand: change the queries in
# rok-syntax or the capture map below, then sync. The other queries in
# languages/ are Zed's own and kept here.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
from=
check=
while [ $# -gt 0 ]; do
	case $1 in
	--from) from=$(cd "$2" && pwd); shift 2 ;;
	--check) check=1; shift ;;
	*) echo "usage: scripts/sync [--from DIR] [--check]" >&2; exit 2 ;;
	esac
done
if [ -n "$from" ] && [ -z "$check" ]; then
	git -C "$from" rev-parse HEAD >"$root/rok-syntax.rev"
fi
rev=$(cat "$root/rok-syntax.rev")

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

get() {
	if [ -n "$from" ]; then
		cp "$from/$1" "$2"
	else
		curl -fsSL "https://raw.githubusercontent.com/rok-lang/rok-syntax/$rev/$1" -o "$2"
	fi
}

# rok-syntax capture -> Zed capture. A capture missing here fails the
# sync, so a new one in rok-syntax gets a deliberate mapping.
zed() {
	perl -e '
		my %map = (
			"attribute" => "attribute",
			"boolean" => "boolean",
			"character" => "string",
			"comment" => "comment",
			"comment.documentation" => "comment.doc",
			"constant.builtin" => "constant.builtin",
			"function" => "function",
			"function.call" => "function",
			"function.macro" => "function.special",
			"keyword" => "keyword",
			"keyword.conditional" => "keyword.control",
			"keyword.coroutine" => "keyword.control",
			"keyword.directive" => "preproc",
			"keyword.exception" => "keyword.control",
			"keyword.function" => "keyword",
			"keyword.import" => "keyword",
			"keyword.modifier" => "keyword",
			"keyword.operator" => "keyword",
			"keyword.repeat" => "keyword.control",
			"keyword.return" => "keyword.control",
			"keyword.type" => "keyword",
			"label" => "label",
			"module" => "variable",
			"module.builtin" => "variable.special",
			"number" => "number",
			"number.float" => "number",
			"operator" => "operator",
			"property" => "property",
			"punctuation.bracket" => "punctuation.bracket",
			"punctuation.delimiter" => "punctuation.delimiter",
			"punctuation.special" => "punctuation.special",
			"string" => "string",
			"string.escape" => "string.escape",
			"string.special" => "string.special",
			"type" => "type",
			"type.builtin" => "type.builtin",
			"variable" => "variable",
			"variable.builtin" => "variable.special",
			"variable.parameter" => "variable.parameter",
		);
		my $bad = 0;
		while (my $line = <STDIN>) {
			# Captures outside strings and comments.
			$line =~ s{("(?:[^"\\]|\\.)*"|;.*$)|\@([\w.]+)}{
				if (defined $1) { $1 }
				elsif (exists $map{$2}) { "\@$map{$2}" }
				else { print STDERR "unmapped capture \@$2\n"; $bad = 1; "\@$2" }
			}ge;
			print $line;
		}
		exit $bad;
	'
}

for lang in rok rokon; do
	mkdir -p "$tmp/languages/$lang"
	src=tree-sitter/$lang/queries
	get "$src/highlights.scm" "$tmp/h.scm"
	{
		echo "; Generated by scripts/sync from rok-syntax $src/highlights.scm."
		echo "; Do not edit."
		echo
		zed <"$tmp/h.scm"
	} >"$tmp/languages/$lang/highlights.scm"
	get "$src/injections.scm" "$tmp/i.scm"
	{
		echo "; Generated by scripts/sync from rok-syntax $src/injections.scm."
		echo "; Do not edit."
		echo
		cat "$tmp/i.scm"
	} >"$tmp/languages/$lang/injections.scm"
done

# rev = "..." under [grammars.rok] and [grammars.rokon].
sed -E "/^\[grammars\./,/^\[/ s/^rev = \".*\"$/rev = \"$rev\"/" \
	"$root/extension.toml" >"$tmp/extension.toml"

if [ -n "$check" ]; then
	status=0
	for lang in rok rokon; do
		for q in highlights injections; do
			f=languages/$lang/$q.scm
			cmp -s "$tmp/$f" "$root/$f" || { echo "$f differs from rok-syntax; run scripts/sync"; status=1; }
		done
	done
	cmp -s "$tmp/extension.toml" "$root/extension.toml" ||
		{ echo "extension.toml grammar rev is not rok-syntax.rev; run scripts/sync"; status=1; }
	exit $status
fi

for lang in rok rokon; do
	cp "$tmp/languages/$lang/highlights.scm" "$tmp/languages/$lang/injections.scm" "$root/languages/$lang/"
done
cp "$tmp/extension.toml" "$root/extension.toml"
if [ -n "$from" ]; then
	[ -z "$(git -C "$from" status --porcelain tree-sitter)" ] ||
		echo "warning: $from has uncommitted changes in tree-sitter/"
	echo "rok-syntax.rev: $rev"
fi
